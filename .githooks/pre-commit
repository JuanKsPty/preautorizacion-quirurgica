#!/usr/bin/env bash
# Bloquea el commit si se cuela un .env o una credencial.
# Se activa con:  git config core.hooksPath .githooks
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

# 1. Ningun archivo de entorno entra al repositorio.
ENV_EN_STAGE="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)\.env(\.local)?$' || true)"
if [ -n "$ENV_EN_STAGE" ]; then
  printf '\033[31mAbortado:\033[0m estos archivos de entorno estan en el commit:\n'
  printf '  %s\n' "$ENV_EN_STAGE"
  printf 'Sacalos con:  git restore --staged <archivo>\n'
  exit 1
fi

# 2. Los archivos que si van al commit pasan por el detector de secretos.
ARCHIVOS="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -n "$ARCHIVOS" ] || exit 0

# shellcheck disable=SC2086
bash scripts/check-secrets.sh $ARCHIVOS
