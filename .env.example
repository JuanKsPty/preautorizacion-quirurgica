# ==============================================================
#  Copia este archivo a .env y llena los valores:
#      cp .env.example .env
#
#  .env NUNCA se sube al repositorio (está en .gitignore y hay
#  un hook pre-commit que lo bloquea).  Reto CONTECS §12.
#
#  Este es el UNICO archivo de entorno: lo leen la API (FastAPI),
#  el frontend (Vite, variables VITE_*) y docker compose.
# ==============================================================

# ---------- Base de datos (Postgres via docker compose) -------
# Ojo: este DATABASE_URL es el que usan los comandos que corres en TU MAQUINA
# (Alembic, seed:host, dev:host). Dentro de docker compose la variable se
# sobreescribe apuntando a "db", que es el nombre de la base en la red interna.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/app

# Alternativa SIN Docker: comenta la linea de arriba y descomenta esta.
# Util si un evaluador no tiene el daemon de Docker corriendo.
# DATABASE_URL=sqlite:///./app.db

# ---------- Seguridad -----------------------------------------
# Genera uno propio con:  openssl rand -hex 32
JWT_SECRET=cambia-esto-por-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=1440

# ---------- IA (opcional) -------------------------------------
# Sin API key el endpoint /api/chat responde 503 con mensaje claro;
# el resto de la aplicacion funciona igual.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- CORS y URLs ---------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=/api

# ---------- Entorno -------------------------------------------
APP_ENV=dev
# En dev las tablas se crean al arrancar. Ponlo en false cuando
# empieces a usar migraciones de Alembic.
AUTO_CREATE_TABLES=true
