# ==============================================================
#  Copia este archivo a .env y llena los valores:
#      cp .env.example .env
#
#  .env NUNCA se sube al repositorio: esta en .gitignore y hay un
#  hook pre-commit (.githooks/pre-commit) que lo bloquea.
#
#  Este es el UNICO archivo de entorno: lo leen la API (FastAPI),
#  el frontend (Vite, variables VITE_*) y docker compose.
# ==============================================================

# ---------- Base de datos (Postgres via docker compose) -------
# Solo guarda la bitacora de dictamenes. La fuente de verdad de polizas e
# informes es Notion (o los datos de demostracion).
#
# Ojo: este DATABASE_URL es el que usan los comandos que corres en TU MAQUINA.
# Dentro de docker compose la variable se sobreescribe apuntando a "db".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/app

# Alternativa SIN Docker: comenta la linea de arriba y descomenta esta.
# DATABASE_URL=sqlite:///./app.db

# ---------- IA (Anthropic) ------------------------------------
# Sin clave, POST /api/preautorizaciones/evaluar responde 503 con un mensaje
# claro y POST /api/preautorizaciones/reglas sigue emitiendo el mismo veredicto
# con las mismas cifras, solo sin la redaccion del modelo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. En "medium" el agente responde en pocos
# segundos: toda la aritmetica dificil la hacen las herramientas deterministas.
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8192

# ---------- Notion --------------------------------------------
# Sin token, la API usa los datos de demostracion del propio codigo y
# /api/health reporta origen_datos: "demo".
#
# Para conectar tu Notion:
#   1. notion.so/my-integrations -> New integration -> copia el secreto
#   2. abre la pagina padre -> ... -> Connections -> agrega esa integracion
#   3. pon aqui el token y los identificadores de las cuatro bases
NOTION_TOKEN=
NOTION_DB_POLIZAS=
NOTION_DB_INFORMES=
NOTION_DB_PROCEDIMIENTOS=
NOTION_DB_PREAUTORIZACIONES=

# ---------- CORS y URLs ---------------------------------------
# En el despliegue la web y la API comparten dominio, asi que CORS no se ejerce.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=/api

# ---------- Entorno -------------------------------------------
APP_ENV=dev
AUTO_CREATE_TABLES=true
