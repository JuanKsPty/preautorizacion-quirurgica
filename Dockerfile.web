# El contexto de build es la RAIZ del repo, porque el lockfile de pnpm y el
# pnpm-workspace.yaml viven alli:   docker build -f web/Dockerfile .
#
# Objetivos:
#   target: dev   -> servidor de Vite con recarga en caliente
#   target: prod  -> build estatico servido por nginx

FROM node:24-alpine AS deps
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile --filter web...

# ---------------------------------------------------------------- desarrollo
FROM deps AS dev
WORKDIR /repo/web
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]

# ---------------------------------------------------------------- produccion
FROM deps AS build
WORKDIR /repo
COPY web ./web
# Sin .env, VITE_API_URL toma su valor por defecto (/api), que es justo lo que
# nginx proxea hacia el contenedor de la API.
RUN pnpm --filter web build

FROM nginx:alpine AS prod
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/web/dist /usr/share/nginx/html
EXPOSE 80
