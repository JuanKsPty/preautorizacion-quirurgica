# Frontend (React + Vite). El contexto de build es la RAIZ del repo, porque el
# lockfile de pnpm y el pnpm-workspace.yaml viven ahi.
#
#   docker build -f Dockerfile.web --target prod .
#
# Objetivos:
#   target: dev   -> servidor de Vite con recarga en caliente
#   target: prod  -> build estatico servido por nginx

FROM node:24-alpine AS deps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile --filter web...

# ---------------------------------------------------------------- desarrollo
FROM deps AS dev
WORKDIR /repo/web
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]

# ---------------------------------------------------------------- produccion
FROM deps AS build
WORKDIR /repo
COPY web ./web
# Vite da prioridad a las VITE_* que ya estan en el entorno sobre las del .env,
# asi que este ARG es lo que queda incrustado en el bundle. Por defecto /api,
# que es la ruta que Traefik enruta a la API en el mismo dominio.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter web build

FROM nginx:alpine AS prod
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
